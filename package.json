{
    "name": "sandestin",
    "version": "0.2.0",
    "description": "Serialize values across any boundary with functions and promises kept live. Pass a callback across, get back a reference that calls home; structured-clone native, JSON optional, lifetime and security in your hands.",
    "keywords": [
        "serialize",
        "serialization",
        "serdes",
        "rpc",
        "postmessage",
        "iframe",
        "worker",
        "structured-clone",
        "function-reference",
        "capability",
        "post-robot",
        "cugel"
    ],
    "homepage": "https://github.com/bluepnume/sandestin#readme",
    "bugs": {
        "url": "https://github.com/bluepnume/sandestin/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bluepnume/sandestin.git"
    },
    "license": "MIT",
    "author": "Daniel Brain",
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=24"
    },
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "import": "./dist/src/index.js"
        },
        "./testing": {
            "types": "./dist/src/testing/index.d.ts",
            "import": "./dist/src/testing/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "cugel-scripts build",
        "fix": "cugel-scripts fix --changed",
        "fix:all": "cugel-scripts fix",
        "imports:missing": "cugel-scripts imports:missing --changed",
        "lint": "cugel-scripts lint",
        "test:static": "cugel-scripts static",
        "test:unit": "cugel-scripts test --coverage",
        "test:watch": "cugel-scripts test --watch",
        "test": "npm run test:static && npm run test:unit && npm run build",
        "prepack": "npm run build"
    },
    "devDependencies": {
        "cugel-scripts": "^0.1.0",
        "esbuild": "^0.28.0"
    }
}
